# Production settings (set these in Vercel Project Settings → Environment Variables)
# for the Vercel Services deployment (frontend + backend in one project/domain).
#
# Do NOT set NEXT_PUBLIC_API_URL in production. When it is empty, the browser
# calls this site's own /api/v1/* path, which the top-level `rewrites` in
# vercel.json route to the `backend` service — this keeps auth cookies
# same-site (SameSite=Lax works fine).

# Route to the backend service at runtime. Vercel injects this automatically
# from the service binding in vercel.json — DO NOT set it yourself.
# BACKEND_URL=<generated by Vercel binding>

# Set to "true" to make proxy.ts pass through (services routing handles /api).
NEXT_PUBLIC_DISABLE_PROXY=true

# Public HTTPS origin of the deployed app (used for invoice QR links)
NEXT_PUBLIC_APP_URL=https://your-shop.vercel.app