# Production settings (set these in Vercel Project Settings → Environment Variables):
#
# Do NOT set NEXT_PUBLIC_API_URL in production. When it is empty, the browser
# calls this site's own /api/v1/* path and the Vercel proxy (proxy.ts) forwards
# to the backend — this keeps auth cookies same-site (SameSite=Lax works fine).

# Public HTTPS origin of the deployed backend (Koyeb / Railway / Render)
NEXT_PUBLIC_BACKEND_URL=https://your-backend.koyeb.app
INTERNAL_API_URL=https://your-backend.koyeb.app

# Public HTTPS origin of the deployed frontend (used for invoice QR links)
NEXT_PUBLIC_APP_URL=https://your-shop.vercel.app