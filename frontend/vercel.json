{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NEXT_PUBLIC_DISABLE_PROXY": "true",
    "INTERNAL_API_URL": "https://YOURBACKEND.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOURBACKEND.onrender.com/api/:path*"
    }
  ]
}