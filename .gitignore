# Root-level ignores for the monorepo

# Skill/agent working directories
/.impeccable/

# Dependencies and tool caches are never committed. A stray root-level
# node_modules/.vite cache had previously been added by mistake.
/node_modules/

# Local error/log dumps
*.err
*.log

# Local environment files (never commit secrets)
/.env
/.env.local
/env/.env

# TLS certs (private keys must never be committed)
/nginx/certs/

# Vercel CLI local link metadata
/.vercel/
.vercel
.env*

# Vercel backend bundle (generated by build:vercel)
/backend/server.cjs
/backend/server.cjs.map
