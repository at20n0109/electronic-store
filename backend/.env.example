NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pc_store?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=pc-store-api
JWT_AUDIENCE=pc-store-web
# Comma-separated browser origins. Use HTTPS origins only in production.
# Development: http://localhost:3000   Production: https://my-shop.vercel.app
CORS_ORIGIN=http://localhost:3000

# Object storage (S3-compatible; MinIO locally / Cloudflare R2 in production)
# MinIO local: S3_ENDPOINT=http://localhost:9000  S3_REGION=us-east-1  S3_ACL=public-read
# Cloudflare R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  S3_REGION=auto  S3_ACL= (empty — R2 does not support ACLs)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=electronic-store
S3_REGION=us-east-1
# Optional x-amz-acl for MinIO; leave empty for R2 (DC: invoice PDFs are served through the API, no public bucket needed)
S3_ACL=public-read
# Optional public base URL for stored objects (empty = no public URL)
S3_PUBLIC_URL=http://localhost:9000

# Payment gateway (vnpay | stripe | mock)
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=replace-with-vnpay-or-stripe-secret
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
PAYMENT_VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
PAYMENT_VNPAY_RETURN_URL=http://localhost:3000/payment/return

# Frontend URL used for invoice QR verification links
NEXT_PUBLIC_APP_URL=http://localhost:3000
