NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pc_store?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_ISSUER=pc-store-api
JWT_AUDIENCE=pc-store-web
# Comma-separated browser origins. Use HTTPS origins only in production.
# Development: http://localhost:3000   Production: https://my-shop.vercel.app
# Wildcards such as https://*.example.com are rejected — list each origin
# explicitly. Origins are matched as exact strings, never as a RegExp.
CORS_ORIGIN=http://localhost:3000

# Object storage (S3-compatible; MinIO locally / Cloudflare R2 in production)
# MinIO local: S3_ENDPOINT=http://localhost:9000  S3_REGION=us-east-1  S3_ACL=public-read
# Cloudflare R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  S3_REGION=auto  S3_ACL= (empty — R2 does not support ACLs)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=electronic-store
S3_REGION=us-east-1
# Optional x-amz-acl for MinIO; leave empty for R2 (DC: invoice PDFs are served through the API, no public bucket needed)
S3_ACL=public-read
# Optional public base URL for stored objects (empty = no public URL)
S3_PUBLIC_URL=http://localhost:9000

# Payment gateway (vnpay | stripe | paypal | momo | bank | cod).
# PAYMENT_PROVIDER is the DEFAULT used when the checkout request omits "provider";
# the frontend calls GET /api/v1/payments/methods and lets the customer pick.
# "mock" and "atm-mock" self-report success without any signature check and are
# only selectable when ALLOW_MOCK_PAYMENT=1 AND NODE_ENV is not "production".
PAYMENT_PROVIDER=cod
PAYMENT_SECRET=replace-with-vnpay-or-stripe-secret
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
PAYMENT_VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
PAYMENT_VNPAY_RETURN_URL=http://localhost:3000/payment/return

# Local sandbox only. NEVER set this in production: mock and atm-mock providers
# mark orders paid without any verification.
ALLOW_MOCK_PAYMENT=0

# Bank transfer details shown to the customer. JSON with bank, accountName and
# accountNumber. No default exists on purpose — never hardcode account details
# in source. The provider refuses to start when this is missing.
BANK_TRANSFER_INFO={"bank":"Vietcombank","accountName":"PC Store","accountNumber":"0123456789","branch":"Hồ Chí Minh"}

# MoMo (All-in-One v2). Merchant keys from https://business.momo.vn (test env).
MOMO_PARTNER_CODE=replace-with-momo-partner-code
MOMO_ACCESS_KEY=replace-with-momo-access-key
MOMO_SECRET_KEY=replace-with-momo-secret-key
MOMO_MODE=sandbox
MOMO_REQUEST_TYPE=captureWallet
MOMO_REDIRECT_URL=http://localhost:3000/api/v1/payments/momo/return
MOMO_IPN_URL=http://localhost:3000/api/v1/payments/webhook

# PayPal (Orders v2). VND is not a supported PayPal currency, so the order
# total is converted to PAYPAL_CURRENCY using the fixed PAYPAL_USD_RATE.
# Sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_SECRET=replace-with-paypal-secret
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=http://localhost:3000/api/v1/payments/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/checkout
PAYPAL_CURRENCY=USD
PAYPAL_USD_RATE=25000

# ---------------------------------------------------------------------------
# GHN (Giao Hàng Nhân) carrier integration
# ---------------------------------------------------------------------------
# Token: producer.ghn.vn -> "Manage token". Staging and production use
# separate tokens; a token that works on one returns 401 on the other.
GHN_TOKEN=replace-with-ghn-token

# Must be the shop this token belongs to. A mismatched id is rejected by GHN
# with CLIENT_NOT_BELONG_OF_SHOP before any address is validated.
GHN_SHOP_ID=replace-with-shop-id

# Always the production gateway once you want consignments that show up on
# khachhang.ghn.vn/manage-order. The sandbox gateway below creates consignments
# that are invisible there, which is the same symptom as "nothing appears".
# Production: https://online-gateway.ghn.vn
# Sandbox:    https://dev-online-gateway.ghn.vn
GHN_BASE_URL=https://online-gateway.ghn.vn

# Sender (warehouse) address. GHN rejects fee and consignment calls with
# SHOP_INFO_ERROR until the shop itself has a registered address, and these
# codes must match that registration: ward = "Phường <n>", district =
# ghhquận từ master-data/district.
GHN_FROM_NAME=replace-with-shop-name
GHN_FROM_PHONE=replace-with-shop-phone
GHN_FROM_ADDRESS=replace-with-street-address
# Phuong Tay Thanh, Quan Tan Phu, TP.HCM. A ward name is not enough to key
# the code: HCMC keeps numeric wards in some districts ("Phuong 4") and named
# ones in others ("Phuong Tay Thanh"), so always look the code up in
# master-data/ward for the exact district the street belongs to.
GHN_FROM_WARD_CODE=21511
GHN_FROM_DISTRICT_ID=1456

# 0 leaves service selection to service_type_id below. A service_id the shop
# has not enabled is rejected with SERVICE_IS_INVALID, so only set this once
# you know the shop's own enabled service id.
GHN_SERVICE_ID=0
GHN_SERVICE_TYPE_ID=2

# Parcel dimensions (grams / centimetres) used for the fee estimate.
GHN_DEFAULT_WEIGHT=500
GHN_DEFAULT_LENGTH=30
GHN_DEFAULT_WIDTH=20
GHN_DEFAULT_HEIGHT=10

# Frontend URL used for invoice QR verification links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Field-level encryption (AES-256-GCM) — base64 of 32 bytes; required, app fails to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP THIS KEY safe: rotating it orphans any already-encrypted rows.
# Never put this value in a source file — tests generate a throwaway key instead,
# and .env is the only place it belongs.
ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
