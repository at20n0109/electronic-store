generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  DRAFT
  HIDDEN
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  name          String?
  phone         String?        @unique
  phoneVerified Boolean        @default(false)
  emailVerified Boolean        @default(false)
  authProvider  String         @default("local")
  providerId    String?
  avatarUrl     String?
  role          Role           @default(CUSTOMER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]

  @@index([email])
  @@index([authProvider, providerId])
}

model Otp {
  id        String    @id @default(uuid())
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([slug])
}

model Product {
  id          String        @id @default(uuid())
  sku         String        @unique
  name        String
  slug        String        @unique
  description String?
  specs       Json?
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  buildItems  PcBuildItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
  @@index([price])
  @@index([status])
  @@index([categoryId])
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  url         String
  alt         String?
  width       Int?
  height      Int?
  blurDataUrl String?
  sortOrder   Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PcBuild {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  tagline     String
  description String?
  budget      Int
  tier        Int
  sortOrder   Int            @default(0)
  items       PcBuildItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([slug])
  @@index([tier])
}

model PcBuildItem {
  id        String   @id @default(uuid())
  buildId   String
  productId String
  slot      String
  sortOrder Int      @default(0)
  build     PcBuild  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buildId, slot])
  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          OrderStatus   @default(PENDING)
  items           OrderItem[]
  subtotal        Decimal       @db.Decimal(12, 2)
  shipping        Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2)
  receiverName    String
  receiverPhone   String
  receiverAddress String
  note            String?
  payment         Payment?
  invoice         Invoice?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  VNPAY
  MOMO
  ZALOPAY
  PAYPAL
  BANK
  COD
  MOCK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model Payment {
  id            String        @id @default(uuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String        @unique
  provider      PaymentProvider
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("VND")
  transactionId String?
  checkoutUrl   String?
  clientSecret  String?
  payload       Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([provider])
  @@index([status])
}

model Invoice {
  id        String    @id @default(uuid())
  order     Order     @relation(fields: [orderId], references: [id])
  orderId   String    @unique
  number    String    @unique
  fileUrl   String?
  issuedAt  DateTime  @default(now())
  paidAt    DateTime?

  @@index([number])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}
model PaymentMetadata {
  id            String   @id @default(cuid())
  orderId       String   @unique
  paymentId     String
  provider      String
  encryptedData String
  iv            String
  authTag       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  confirmedAt   DateTime?
  confirmedBy   String?
  note          String?

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
}
